# Copy to .env and fill in. Placeholders only -- never commit a real key.
# The whole pipeline runs with NO keys set: leave PRIMARY_PROVIDER=deterministic.

# ---- LLM providers ----------------------------------------------------------
# Set one of these and switch PRIMARY_PROVIDER to prove the model swap.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

PRIMARY_PROVIDER=deterministic       # anthropic | openai | deterministic
FALLBACK_PROVIDER=deterministic      # never leave the triage path without a fallback
TRIAGE_MODEL=claude-opus-5
FALLBACK_MODEL=gpt-4.1-mini
JUDGE_MODEL=claude-opus-5

# ---- infrastructure ---------------------------------------------------------
DATABASE_URL=postgresql://fraudsight:fraudsight@localhost:5432/fraudsight
REDIS_URL=redis://localhost:6379/0
VECTOR_BACKEND=local                 # pgvector | local
FEATURE_BACKEND=local                # redis  | local

# ---- observability ----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- routing bands ---------------------------------------------------------
# Overwritten by `make thresholds`; these are only the cold-start defaults.
AUTO_APPROVE_BELOW=0.15
AUTO_BLOCK_ABOVE=0.95

# ---- cost matrix (business inputs, not hyperparameters) --------------------
FRAUD_LOSS_USD=180.0
FALSE_DECLINE_USD=25.0
ANALYST_REVIEW_USD=4.20
TRIAGE_LLM_USD=0.0012

# ---- budget guard ----------------------------------------------------------
DAILY_LLM_BUDGET_USD=20.0
TRIAGE_TIMEOUT_S=8.0
